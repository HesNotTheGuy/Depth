{
  "name": "depth-electron",
  "private": true,
  "version": "0.0.0",
  "description": "Depth desktop app — Electron shell wrapping the web UI with a native C++ sidecar.",
  "main": "dist/main.js",
  "scripts": {
    "build:ts": "esbuild src/main.ts src/preload.ts src/sidecar.ts --bundle --platform=node --external:electron --target=node20 --format=cjs --outdir=dist",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:ts",
    "dev": "npm run build:ts && electron .",
    "package": "npm run build && electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.0",
    "@types/node": "^22.0.0"
  }
}
